# Portfolio contact form endpoint.
#
# Local setup: copy this file to .env and paste your Google Apps Script
# Web App URL (the one ending in /exec). Next.js reads .env automatically —
# restart `npm run dev` after changing it.
#
# In CI/production this value comes from the GitHub Secret
# NEXT_PUBLIC_CONTACT_ENDPOINT instead (see .github/workflows/deploy.yml).
#
# Leave empty to render the mailto fallback card instead of the form.
NEXT_PUBLIC_CONTACT_ENDPOINT=
